# HOTFOLK® – WebSupport (Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/cz/#">
ErrorDocument 404 /cz/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/de/#">
ErrorDocument 404 /de/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/en/#">
ErrorDocument 404 /en/404.html
</If>

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(jpe?g|png|webp|ico)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

RewriteEngine On
# www + https
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

# staré adresy z WordPressu
RewriteRule ^wp-(admin|login\.php) / [L,R=301]
# /index.html → /
RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
Redirect 301 /fotogaleria/ https://www.hotfolk.sk/galeria/
Redirect 301 /historia/ https://www.hotfolk.sk/o-nas/
Redirect 301 /blog/ https://www.hotfolk.sk/
Redirect 301 /viktoriabiele/ https://eshop.hotfolk.sk/plavky-hotfolk/
Redirect 301 /bielebrazilkysriasenimivanka/ https://eshop.hotfolk.sk/plavky-hotfolk/
Redirect 301 /eliskacierne/ https://eshop.hotfolk.sk/plavky-hotfolk/
Redirect 301 /plavky-hotfolk/ https://eshop.hotfolk.sk/plavky-hotfolk/
Redirect 301 /nastenny-kalendar-zadeckovy/ https://eshop.hotfolk.sk/nastenny-kalendar-zadeckovy/
Redirect 301 /stolovy-kalendar-pre-panov/ https://eshop.hotfolk.sk/stolovy-kalendar-pre-panov/
Redirect 301 /eshop/ https://eshop.hotfolk.sk/
Redirect 301 /patreon/ https://www.patreon.com/hotfolk

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
